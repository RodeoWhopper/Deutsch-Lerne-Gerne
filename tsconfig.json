{
  "compilerOptions": {
    "target": "ES2023", "module": "ESNext", "moduleResolution": "Bundler", "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true, "noEmit": true, "allowImportingTsExtensions": true, "skipLibCheck": true, "jsx": "react-jsx", "jsxImportSource": "preact",
    "types": ["node"], "erasableSyntaxOnly": true, "verbatimModuleSyntax": true, "isolatedModules": true
  },
  "include": ["src", "scripts", "test", "vite.config.ts"]
}
