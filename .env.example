# Copy to .env (never commit .env). No secrets are required in env except the optional backup key.
PORT=8080
DATA_DIR=/data
# Number of trusted reverse-proxy hops in front of the app (Fly/Railway/Caddy/nginx = 1)
TRUST_PROXY=1
# Brute-force thresholds (failures before exponential delay starts)
IP_FAIL_THRESHOLD=5
GLOBAL_FAIL_THRESHOLD=20
# argon2id memory in KiB used by `npm run setup` calibration (>= 65536)
ARGON_MEMORY_KIB=65536
# age PUBLIC key (age1...) for `npm run backup`; private key stays offline
BACKUP_AGE_RECIPIENT=
# --- docker-compose + Cloudflare Tunnel ---
TUNNEL_TOKEN=
APP_HOST=dlg.runiksoft.com
