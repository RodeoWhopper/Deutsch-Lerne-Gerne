{
  "name": "deutsch-terminal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "dev:server": "node --disable-warning=ExperimentalWarning src/server/index.ts",
    "dev:client": "vite",
    "build": "vite build && node scripts/build-sw.mjs",
    "start": "node --disable-warning=ExperimentalWarning src/server/index.ts",
    "setup": "node --disable-warning=ExperimentalWarning scripts/setup.ts",
    "reset-credentials": "node --disable-warning=ExperimentalWarning scripts/setup.ts --reset",
    "pack:validate": "node scripts/pack-validate.ts",
    "schema:gen": "node scripts/gen-schema.ts",
    "backup": "node --disable-warning=ExperimentalWarning scripts/backup.ts",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "2.1.8",
    "@node-rs/argon2": "2.2.2",
    "hono": "4.13.19",
    "preact": "11.2.0",
    "qrcode-terminal": "0.12.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@preact/preset-vite": "2.10.6",
    "@types/node": "26.6.6",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
